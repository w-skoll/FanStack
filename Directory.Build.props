<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Nessun percorso locale (nome utente, cartelle) dentro gli eseguibili compilati -->
    <PathMap>$(MSBuildThisFileDirectory)=/FanStack/</PathMap>
    <Company>FanStack</Company>
    <Product>FanStack</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
