<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FanStack</AssemblyName>
    <RootNamespace>FanStack.App</RootNamespace>
    <StartupObject>FanStack.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FanStack.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Avvio rapido: niente globalizzazione completa, PGO dinamico, ReadyToRun in publish -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FanStack.Core\FanStack.Core.csproj" />
  </ItemGroup>

</Project>

